# Copier en .env. Lu par docker compose.

# URL de l'API appelée par le navigateur (sans slash final). Exemples :
#   http://localhost:3000                  -> API lancée en local (docker ou npm)
#   https://api-recette.ekwatech.com       -> API partagée / serveur
API_URL=http://localhost:3000

# Port du front (image nginx)
FRONT_PORT=8080
# Port du front en mode dev (ng serve)
FRONT_DEV_PORT=4200
